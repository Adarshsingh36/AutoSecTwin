# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Application ---
APP_NAME=AutoSecTwin ASDE
APP_VERSION=0.1.0
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL only) ---
DATABASE_URL=postgresql+psycopg2://asde_user:asde_password@localhost:5432/asde_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Metasploit RPC ---
METASPLOIT_RPC_HOST=127.0.0.1
METASPLOIT_RPC_PORT=55553
METASPLOIT_RPC_USER=msf
METASPLOIT_RPC_PASSWORD=change-me
METASPLOIT_RPC_SSL=true

# --- External intelligence sources ---
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
THREAT_INTEL_API_BASE_URL=
THREAT_INTEL_API_KEY=

# --- Digital Twin integration ---
DIGITAL_TWIN_API_BASE_URL=http://localhost:8100
DIGITAL_TWIN_API_KEY=

# --- ML / Confidence Fusion ---
ML_MODEL_DIR=ml/models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CONFIDENCE_FUSION_WEIGHTS=0.4,0.3,0.3
