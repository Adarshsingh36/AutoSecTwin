# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.
#
# NOTE: these variable names match core.config.Settings exactly. The
# previous version of this file used names (DATABASE_URL, METASPLOIT_RPC_HOST,
# METASPLOIT_RPC_PORT, DIGITAL_TWIN_API_BASE_URL, ...) that Settings never
# actually reads -- silently ignored by pydantic-settings' extra="ignore".

# --- Application ---
APP_NAME=AutoSecTwin ASDE
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# Composed into postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asde_db
DB_USER=<database-user>
DB_PASSWORD=<database-password>
# Optional: bypass the composed Postgres URL entirely, e.g. for local
# SQLite development/testing: DATABASE_URL_OVERRIDE=sqlite:///./autosectwin.db
DATABASE_URL_OVERRIDE=

# --- Metasploit RPC ---
METASPLOIT_RPC_URL=http://localhost:55552/api/
METASPLOIT_RPC_USERNAME=<metasploit-rpc-user>
METASPLOIT_RPC_PASSWORD=<metasploit-rpc-password>

# --- API authentication ---
# Keep enabled outside isolated tests. Use AUTH_USERS_JSON with PBKDF2 hashes,
# AUTH_STATIC_TOKEN_HASHES_JSON with sha256(token) keys, or both.
#AUTH_ENABLED=false

#AUTH_SECRET_KEY=<long-random-signing-secret>
#AUTH_TOKEN_TTL_SECONDS=3600
#AUTH_USERS_JSON={}
#AUTH_STATIC_TOKEN_HASHES_JSON={}
# Development only. Refused when ENVIRONMENT=production.
#AUTH_DEV_ADMIN_TOKEN=

# --- Digital Twin Generator ---
DIGITAL_TWIN_BASE_URL=http://localhost:8081

# --- External intelligence sources ---
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
EXPLOITDB_BASE_URL=https://www.exploit-db.com
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- LLM providers (optional) ---
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- AutoSecTwin closed-loop orchestration ---
# When true, Digital Twin and Metasploit RPC calls are simulated
# deterministically so the closed loop can run/be demoed without that
# infrastructure. Never leave this on in a real deployment.
MOCK_MODE=false
TWIN_HEALTH_POLL_INTERVAL_SECONDS=2.0
TWIN_HEALTH_TIMEOUT_SECONDS=120.0
REMEDIATION_AUTO_APPLY=true
ORCHESTRATION_DESTROY_TWIN_AFTER_RUN=true
ENFORCE_DIGITAL_TWIN_BOUNDARY=true
