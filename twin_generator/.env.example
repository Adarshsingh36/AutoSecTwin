# Digital Twin Generator settings.
# Append these to the project's existing .env -- this module adds no
# database/broker connection settings of its own (it reuses core.database
# and whichever background-task infra AutoSecTwin already has configured).

# --- Docker Twin Engine -----------------------------------------------
DOCKER_TWIN_HEALTH_CHECK_TIMEOUT_SECONDS=60
DOCKER_TWIN_HEALTH_CHECK_POLL_INTERVAL_SECONDS=2.0
DOCKER_TWIN_UNGRACIOUS_GRACE_PERIOD_SECONDS=3.0
DOCKER_TWIN_IMAGE_PULL_TIMEOUT_SECONDS=300
DOCKER_TWIN_DEFAULT_NETWORK_DRIVER=bridge

# --- VM Twin Engine ------------------------------------------------------
VM_TWIN_VBOXMANAGE_PATH=VBoxManage
VM_TWIN_DEFAULT_SNAPSHOT_NAME=clean-snapshot
VM_TWIN_DEFAULT_ISOLATED_INTNET=twin-intnet
VM_TWIN_BOOT_TYPE=headless
VM_TWIN_HEARTBEAT_TIMEOUT_SECONDS=120
VM_TWIN_HEARTBEAT_POLL_INTERVAL_SECONDS=3.0
VM_TWIN_COMMAND_TIMEOUT_SECONDS=60

# --- Twin Monitor ----------------------------------------------------------
TWIN_MONITOR_POLL_INTERVAL_SECONDS=30.0
TWIN_MONITOR_AUTO_RESTART_FAILED_CONTAINERS=true
TWIN_MONITOR_VM_METRICS_PERIOD_SECONDS=1
TWIN_MONITOR_VM_METRICS_SETTLE_SECONDS=1.2

# --- Twin Cleanup Manager --------------------------------------------------
TWIN_CLEANUP_SWEEP_INTERVAL_SECONDS=300.0
TWIN_CLEANUP_DEFAULT_TTL_SECONDS=3600
TWIN_CLEANUP_REMOVE_ORPHANED_STOPPED_CONTAINERS=true
TWIN_CLEANUP_PRUNE_UNUSED_NETWORKS=true
TWIN_CLEANUP_PRUNE_UNUSED_VOLUMES=true
# Off by default -- VBoxManage can't reliably report snapshot age across
# versions, so this deletes every non-baseline snapshot, not truly "old"
# ones. Review before enabling.
TWIN_CLEANUP_ENABLE_SNAPSHOT_CLEANUP=false
