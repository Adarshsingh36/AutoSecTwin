# Leave unset to use the Vite dev-server proxy (see vite.config.ts), which
# forwards /api/* to VITE_BACKEND_URL (defaults to http://127.0.0.1:8000).
# Set this instead for a production build talking to a deployed backend:
# VITE_API_BASE_URL=https://api.your-deployment.example.com
VITE_BACKEND_URL=http://127.0.0.1:8000
